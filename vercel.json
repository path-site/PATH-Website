{
  "buildCommand": "npm_config_cache_dir=\"\" npm --prefix frontend install --no-fund --no-audit && npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/chat",
      "destination": "/api/chat"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://path-website-production.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
